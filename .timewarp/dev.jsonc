// Per-repo dev-cli configuration (TimeWarp.Nuru.DevCli RepoConfigService).
// feeds is absent, so check-version and dev release read nuget.org only.
// The package set is every IsPackable project under source/.
{
  "checkVersionConfig": {
  },
  // Additions to PullRequestBuildClassifier (dev workflow on a pull request).
  // readme.md and assets/logo.png are packed into the nupkg, so a pull request
  // that touches only them must still build and pack. The defaults would skip
  // them (root markdown and assets/**).
  "pullRequestBuild": {
    "buildPaths": [
      "readme.md",
      "assets/logo.png"
    ]
  }
}
